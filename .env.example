# Copy this file to .env and fill in your real values.
# .env is gitignored and will NEVER be committed to GitHub.

# Gmail credentials (used for session summary & shopping report emails)
GMAIL_USER="your.email@gmail.com"
GMAIL_APP_PW="your_16_character_app_password"

# Ollama server URL (no API key needed — Ollama runs locally with no auth)
OLLAMA_BASE_URL="http://192.168.1.24:11434"

# Optional: ServiceNow (uncomment if needed)
# SERVICENOW_PW=your-service-now-password

# --- MODEL ROSTER (optional overrides) ---
# Defaults are set in Jarvis_master.py. Uncomment any line to override.
# MODEL_ROUTER=llama3.2:1b          # Always-warm, fast classifier
# MODEL_GENERAL=llama3.1:8b         # Research, recipes, conversation
# MODEL_CHAT=dolphin-mistral:7b     # Uncensored Q&A / complex reasoning
# MODEL_CODE_FAST=qwen2.5-coder:7b  # Quick scripts & snippets
# MODEL_CODE_DEEP=deepseek-coder:6.7b  # Full apps, architecture, complex code
